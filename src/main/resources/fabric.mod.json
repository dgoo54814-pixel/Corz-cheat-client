{
  "schemaVersion": 1,
  "id": "corzstyle",
  "version": "${version}",
  "name": "Corz-Inspired Client",
  "description": "Original Fabric client with a dark module menu inspired by provided reference screenshots. Unaffiliated with CORZ.",
  "authors": ["Independent demo"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.corzstyle.client.CorzClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "=${mc_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
